# Local development only. Copy to .env and replace the password before starting.
POSTGRES_USER=digix
POSTGRES_DB=digix
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=3000
# APISIX is the only host-facing API entry point; NestJS stays inside Compose.
GATEWAY_PORT=3001
# APISIX OIDC schema requires this even for JWKS-only bearer verification.
GATEWAY_OIDC_CLIENT_SECRET=replace-with-a-local-random-value
KEYCLOAK_PORT=8080
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-another-local-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-admin-password
OIDC_ISSUER=http://localhost:8080/realms/digix
OIDC_AUDIENCE=digix-api
OIDC_JWKS_URI=http://keycloak:8080/realms/digix/protocol/openid-connect/certs

# Flowable REST uses its own PostgreSQL database and internal service account.
FLOWABLE_PORT=8082
FLOWABLE_DB_USER=flowable
FLOWABLE_DB_NAME=flowable
FLOWABLE_DB_PASSWORD=replace-with-a-local-flowable-db-password
FLOWABLE_REST_ADMIN_USER=rest-admin
FLOWABLE_REST_ADMIN_PASSWORD=replace-with-a-local-flowable-admin-password
WORKFLOW_BASE_URL=http://workflow-engine:8080/flowable-rest
WORKFLOW_REQUEST_TIMEOUT_MS=5000

# S3-compatible object storage. The API uses this contract instead of
# depending directly on SeaweedFS so another S3 provider can replace it.
S3_PORT=8333
S3_ENDPOINT=http://object-storage:8333
S3_REGION=us-east-1
S3_BUCKET=digix-files
S3_ACCESS_KEY_ID=replace-with-a-local-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-local-s3-secret-key
S3_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_MAX_BYTES=10485760
STORAGE_UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
SEAWEEDFS_ADMIN_PORT=12535
SEAWEEDFS_ADMIN_USER=admin
SEAWEEDFS_ADMIN_PASSWORD=replace-with-a-local-admin-password

DEMO_USER_USERNAME=dung.demo
DEMO_USER_PASSWORD=replace-with-a-local-demo-password
DEMO_USER_EMAIL=dung.demo@example.test
DEMO_USER_DISPLAY_NAME=Dung Demo
DEMO_TENANT_SLUG=tenant_alpha
DEMO_TENANT_NAME=Tenant Alpha

AUTH_SECRET=replace-with-a-local-auth-secret
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=digix-web
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/digix
AUTH_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
AUTH_TRUST_HOST=true
