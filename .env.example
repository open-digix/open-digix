# Local development only. Copy to .env and replace the password before starting.
POSTGRES_USER=digix
POSTGRES_DB=digix
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=3000
API_PORT=3001
KEYCLOAK_PORT=8080
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-another-local-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-admin-password
OIDC_ISSUER=http://localhost:8080/realms/digix
OIDC_AUDIENCE=digix-api
OIDC_JWKS_URI=http://keycloak:8080/realms/digix/protocol/openid-connect/certs
