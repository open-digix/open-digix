{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digix.example/schema/app-v2.5",
  "title": "DigiX published composable application v2.5 (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "appId", "version", "name", "features", "roles", "pages"],
  "properties": {
    "schemaVersion": { "const": "2.5" },
    "startingPoint": { "enum": ["erp", "crm", "blank"], "description": "Optional creation provenance; never determines enabled features, authorization or runtime behavior." },
    "tenantId": { "$ref": "#/$defs/id" },
    "appId": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "features": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/featureId" },
          "version": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "permissions"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "featureId", "trigger"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "featureId": { "$ref": "#/$defs/featureId" },
          "trigger": { "$ref": "#/$defs/id" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "featureId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}\\.[a-z][a-z0-9_-]{1,63}$" },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "path", "layout", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/id" },
        "layout": { "enum": ["single", "two_columns"] },
        "menuOrder": { "type": "integer", "minimum": 0 },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "featureId", "resource", "zone"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["form", "table", "detail", "metric", "action"] },
        "featureId": { "$ref": "#/$defs/featureId" },
        "resource": { "$ref": "#/$defs/id" },
        "action": { "$ref": "#/$defs/id" },
        "zone": { "enum": ["main", "side"] },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
